{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user of the loyalty program",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "User's first name" },
        "lastName": { "type": "string", "description": "User's last name" },
        "phone": { "type": "string", "description": "User's phone number" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "points": { "type": "number", "description": "Current loyalty points (0-6)" },
        "role": { "type": "string", "enum": ["client", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "name", "lastName", "phone", "email", "points", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and their loyalty points"
    }
  }
}
